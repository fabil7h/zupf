---
import { href, pages } from '../lib/nav';

const { current } = Astro.props as { current: string };
---

<div>
  <div class="mb-2 text-xs font-semibold text-fg">Usage</div>
  {
    pages.map((p) => (
      <a class="guide-link" href={href(p.slug)} aria-current={p.slug === current ? 'page' : undefined}>
        {p.title}
      </a>
    ))
  }
</div>
