{
  "name": "@lzth/zupf",
  "version": "0.1.1",
  "description": "Native-feeling drawer / bottom sheet, pull-to-refresh and gestures for any framework.",
  "keywords": [
    "angular",
    "astro",
    "bottom-sheet",
    "dialog",
    "double-tap",
    "drawer",
    "framework-agnostic",
    "gestures",
    "ios",
    "lit",
    "long-press",
    "mobile",
    "modal",
    "preact",
    "pull-to-refresh",
    "qwik",
    "react",
    "sheet",
    "snap-points",
    "solid",
    "solidjs",
    "svelte",
    "swipe",
    "touch",
    "typescript",
    "vanilla",
    "vaul",
    "vue",
    "web-components"
  ],
  "bugs": "https://github.com/fabil7h/zupf/issues",
  "license": "MIT",
  "author": "fabil7h",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabil7h/zupf.git"
  },
  "workspaces": [
    "docs"
  ],
  "files": [
    "dist",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./pull-to-refresh.css": "./dist/pull-to-refresh.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp lint && vp pack",
    "docs:dev": "npm run dev -w docs",
    "docs:build": "npm run build -w docs",
    "docs:preview": "npm run preview -w docs",
    "docs:start": "npm run docs:build && npm run docs:preview",
    "check": "npm run check -w docs && vp check",
    "lint": "vp lint",
    "test": "vp test",
    "test:unit": "vp test --project unit",
    "test:browser": "vp test --project browser",
    "test:perf": "vp test --project perf",
    "test:size": "vp test --project size",
    "prepublishOnly": "vp check && vp test && vp pack"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "publint": "0.3.25",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.23.4"
    }
  }
}
