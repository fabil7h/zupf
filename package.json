{
  "name": "zupf",
  "version": "0.1.0",
  "private": true,
  "description": "Native-feeling drawer / bottom sheet, pull-to-refresh and gestures for any framework. Drawer based on vaul.",
  "keywords": [
    "bottom-sheet",
    "dialog",
    "drawer",
    "framework-agnostic",
    "gestures",
    "pull-to-refresh",
    "sheet",
    "vanilla"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./pull-to-refresh.css": "./dist/pull-to-refresh.css"
  },
  "scripts": {
    "dev": "vp dev docs",
    "build": "vp lint && vp pack",
    "docs:build": "vp lint && vp build docs && node docs/prerender.mjs",
    "docs:preview": "vp preview docs",
    "docs:start": "npm run docs:build && npm run docs:preview",
    "check": "vp check",
    "lint": "vp lint",
    "test": "vp test",
    "test:unit": "vp test --project unit",
    "test:browser": "vp test --project browser",
    "prepublishOnly": "vp check && vp test && vp pack"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@preact/signals": "^2.11.4",
    "@tailwindcss/vite": "^4.3.5",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "preact": "^11.2.0",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.8.3",
    "publint": "^0.3.25",
    "tailwindcss": "^4.3.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0",
    "wrangler": "^4.165.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
