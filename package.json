{
  "name": "tugsheet",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic, customizable drawer / bottom sheet. A port of vaul.",
  "keywords": [
    "bottom-sheet",
    "dialog",
    "drawer",
    "framework-agnostic",
    "sheet",
    "vanilla"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vp dev docs",
    "build": "vp pack",
    "docs:build": "vp build docs",
    "docs:preview": "vp preview docs",
    "check": "vp check",
    "test": "vp test",
    "test:unit": "vp test --project unit",
    "test:browser": "vp test --project browser",
    "prepublishOnly": "vp check && vp test && vp pack"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@preact/signals": "^2.11.4",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "preact": "^11.2.0",
    "publint": "^0.3.25",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
